post_install() {
  # Grant desktop-session access to download-mode devices and keep
  # ModemManager away from them. Tolerate missing udevd (chroot builds).
  udevadm control --reload 2>/dev/null || true
  udevadm trigger 2>/dev/null || true
  cat <<EOF
==> Ultron installed.
    USB device permissions were reloaded (70-ultron.rules).
    You still need your device's own signed firehose programmer (.mbn/.elf)
    and rawprogram/patch XML files to flash.
EOF
}

post_upgrade() {
  post_install
}

post_remove() {
  udevadm control --reload 2>/dev/null || true
}
