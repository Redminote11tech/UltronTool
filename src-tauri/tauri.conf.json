{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultron",
  "version": "0.1.0",
  "identifier": "io.github.redminote11tech.Ultron",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../ui-ts",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../ui-ts",
    "frontendDist": "../ui-ts/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ultron",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false
  }
}
